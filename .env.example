APP_NAME="Email API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=uniform.de.hostns.io
DB_PORT=3306
DB_DATABASE=email_api
DB_USERNAME=email_api_user
DB_PASSWORD=email@User

# Broadcast, Cache, Filesystem, Queue, Session
BROADCAST_DRIVER=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Mail Configuration for cPanel (Default)
# Use sendmail/Exim for cPanel hosting
MAIL_MAILER=sendmail
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Sendmail path (default for cPanel)
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"

# Amazon SES Configuration (Optional - configure per domain in database)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# Redis (Optional - for queue/cache)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================
# Admin API Key (for managing domains)
# ============================================
# Generate with: php -r "echo 'admin_' . bin2hex(random_bytes(32));"
ADMIN_API_KEY=admin_your_secure_key_here

# Inbound deal replies — forwarded to CRM webhook by email:poll-inbound
INBOUND_CRM_WEBHOOK_URL=https://crm.absterco.com/api/webhooks/email-api/inbound-deal-reply
INBOUND_CRM_WEBHOOK_SECRET=your_shared_inbound_secret

# Vite (Optional - not needed for API-only)
VITE_APP_NAME="${APP_NAME}"

# ============================================
# Absterco CRM domain SMTP (used by AbstercoCrmSeeder only — not committed)
# ============================================
# CRM_DOMAIN_SMTP_PASSWORD='...'    # system@crm.absterco.com (automated mail)
# EMAIL_DOMAIN_SMTP_PASSWORD='...'  # noreply@email.absterco.com (outreach fallback)

# ============================================
# Inbound deal replies — CRM webhook (global)
# ============================================
# IMAP: staff_mailboxes on email.absterco.com + optional domain inbound config.
# crm.absterco.com automated mail should keep inbound.enabled false.

INBOUND_CRM_WEBHOOK_URL=https://crm.absterco.com/api/webhooks/email-api/inbound-deal-reply
INBOUND_CRM_WEBHOOK_SECRET=your_inbound_webhook_secret
